# Hosted Cloudflare runtime: set through deployment environment settings.
# Local Vinext preview: copy this to .dev.vars (not .env).
# MUST be false before any public/commercial deployment.
DEMO_MODE=false
# DB is a D1 binding configured in .openai/hosting.json, not a connection string.
# Reserved for a future PostgreSQL adapter; not consumed by the current API.
DATABASE_URL=
# Future integrations only; not consumed until implemented.
MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
